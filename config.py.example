# operations.db — RcloneInventory, DedupRecords, PikpakHistory
HISTORY_DB_PATH = 'reports/history.db'
REPORTS_DB_PATH = 'reports/reports.db'
OPERATIONS_DB_PATH = 'reports/operations.db'

# Output directories for CSV reports (inside REPORTS_DIR)
# Reports are stored in REPORTS_DIR/DailyReport/YYYY/MM/ and REPORTS_DIR/AdHoc/YYYY/MM/
DAILY_REPORT_DIR = 'reports/DailyReport'
AD_HOC_DIR = 'reports/AdHoc'

# History file (stored directly in REPORTS_DIR)
PARSED_MOVIES_CSV = 'parsed_movies_history.csv'

# =============================================================================
# PikPak Information
# =============================================================================
PIKPAK_EMAIL = "me@example.com"
PIKPAK_PASSWORD = "password"
PIKPAK_LOG_FILE = "logs/pikpak_bridge.log"

# Delay between PikPak offline download requests (in seconds)
# This helps avoid rate limiting when processing multiple torrents
PIKPAK_REQUEST_DELAY = 2

# PikPak root folder for offline downloads.
# pikpak_bridge stores every magnet under ``{PIKPAK_ROOT_FOLDER}/{qB category}``,
# so a torrent in qBittorrent category "Ad Hoc" lands in
# ``/Javdb_AutoSpider/Ad Hoc`` on PikPak. Missing folders are auto-created.
# Override at runtime via ``--root-folder`` or the GitHub Variable
# ``PIKPAK_ROOT_FOLDER``.
PIKPAK_ROOT_FOLDER = "/Javdb_AutoSpider"

# =============================================================================
# Rclone Configuration (for Google Drive inventory and dedup)
# =============================================================================

# Base64-encoded rclone.conf content
# Generate with: base64 -w0 ~/.config/rclone/rclone.conf
RCLONE_CONFIG_BASE64 = ''

# Remote root as rclone remote:path (e.g. 'gdrive:/剧集/MyFolder' or 'gdrive:' for remote root)
RCLONE_FOLDER_PATH = 'gdrive:/剧集/不可以色色/JAV-Sync'

# =============================================================================
# Dedup Configuration
# =============================================================================

# Rclone inventory CSV filename (stored in REPORTS_DIR)
RCLONE_INVENTORY_CSV = 'rclone_inventory.csv'

# Dedup records CSV filename (stored in REPORTS_DIR, persistent across runs)
DEDUP_CSV = 'dedup.csv'

# Log file for rclone dedup executor
DEDUP_LOG_FILE = 'logs/rclone_dedup.log'

# =============================================================================
# qBittorrent File Filter Configuration
# =============================================================================

# Minimum file size threshold in MB
# Files smaller than this will be set to "do not download" priority
# This helps filter out small files like NFO, samples, screenshots, etc.
QB_FILE_FILTER_MIN_SIZE_MB = 100

# Log file for the file filter script
QB_FILE_FILTER_LOG_FILE = 'logs/qb_file_filter.log'

# =============================================================================
# TORRENT QUALITY EVIDENCE
# =============================================================================

# ADR-024 Phase 1 is read-only and shadow-only: collect quality evidence without
# changing torrent selection or download behaviour.
TORRENT_QUALITY_EVIDENCE_ENABLED = False

# Controls the active phase of ADR-024 torrent quality evaluation:
#   'shadow'  — Phase 1 (default): collect evidence only; never changes downloads.
#   'assist'  — Phase 2 (ADR-024 IMP-08): rank probe vs production evidence and
#               surface recommendations via the /api/quality API. Still no
#               production-path change — writes shadow evaluations + review labels
#               only. Requires TORRENT_QUALITY_EVIDENCE_ENABLED and
#               QUALITY_PROBE_ENABLED to also be True.
#   'enforce' — Phase 3 (ADR-024 IMP-09, reserved): not yet implemented.
TORRENT_QUALITY_POLICY_MODE = 'shadow'

# Optional JSON array of qBittorrent categories, e.g. '["Daily Ingestion"]'.
# Empty means no category filter is configured; direct collection skips rather
# than scanning every qBittorrent category.
TORRENT_QUALITY_CATEGORIES = ''

# --- ADR-024 Phase 2 prerequisite: remote quality_probe endpoint (IMP-10) ---
# Runner-up shadow probing. Capture (Top-K runner-up enqueue) is gated by
# TORRENT_QUALITY_EVIDENCE_ENABLED above. Probing the runner-ups on a dedicated
# REMOTE qBittorrent requires QUALITY_PROBE_ENABLED *and* a configured endpoint.
# Both default off: a fresh deploy captures nothing and probes nothing.
QUALITY_PROBE_ENABLED = False
QUALITY_PROBE_QB_URL = ''          # Dedicated remote qB; never the production NAS qB
QUALITY_PROBE_QB_USERNAME = ''     # Falls back to QB_USERNAME when empty
QUALITY_PROBE_QB_PASSWORD = ''     # Falls back to QB_PASSWORD when empty
QUALITY_PROBE_TOPK = 2             # Runner-up magnets captured per category
QUALITY_PROBE_GLOBAL_CAP = 50      # Max runner-ups enqueued per ingestion run

# =============================================================================
# API CONSOLE / BACKEND SERVICE
# =============================================================================
# These settings configure the FastAPI service that backs the web console
# (javdb-autospider-web). Environment variables override these values, so
# CI / Docker secrets / cloud-secret-managers continue to work — but for
# single-host self-hosting you can keep everything here in this single file.
#
# CHANGE ADMIN_PASSWORD AND API_SECRET_KEY BEFORE EXPOSING THE SERVICE
# TO THE INTERNET.

# Ingestion mode: 'local' (run spider in-process), 'github' (dispatch
# GitHub Actions workflows), or 'dual'.
INGESTION_MODE = 'local'

# HS256 signing key for JWT. MUST be >= 32 chars. The API generates an
# ephemeral random key in non-production if this is empty; in production
# (ENVIRONMENT=production) startup fails when this is empty.
API_SECRET_KEY = ''

# Admin login.
#   ADMIN_USERNAME defaults to 'admin' if blank.
#   ADMIN_PASSWORD is plaintext — the BE bcrypt-hashes it in memory at
#   startup and verifies submitted passwords against that hash. You do
#   NOT need to compute the hash yourself.
#   In production (ENVIRONMENT=production) startup fails if both are
#   blank. In non-production, leaving ADMIN_PASSWORD blank generates a
#   random ephemeral password printed to the BE log.
# Advanced — pre-hashed alternative: if you'd rather not store the
# plaintext password in this file (e.g. checked into a private repo),
# pre-compute a bcrypt hash and set ADMIN_PASSWORD_HASH instead of
# ADMIN_PASSWORD. The hash wins over the plaintext when both are set:
#   python3 -c "from passlib.context import CryptContext; \
#               print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
# ADMIN_PASSWORD_HASH = '$2b$12$...'
ADMIN_USERNAME = 'admin'
ADMIN_PASSWORD = 'changeme'

# Optional readonly login. Leave both blank to disable readonly access.
# Same plaintext-vs-hash rules as ADMIN_PASSWORD above.
READONLY_USERNAME = 'readonly'
READONLY_PASSWORD = ''
# READONLY_PASSWORD_HASH = '$2b$12$...'

# GitHub Actions integration tier:
#   'none'    - disabled
#   'monitor' - list runs, dispatch workflows, view logs
#   'edit'    - above + edit workflow YAML
#   'admin'   - above + manage secrets
GH_ACTIONS_TIER = 'none'
GH_ACTIONS_REPO = ''          # 'owner/repo' format; empty defaults to github.repository
GH_ACTIONS_TOKEN = ''         # PAT with 'workflow' scope (or 'admin:repo_hook' for tier=admin)
