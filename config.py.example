EMAIL_TO = 'your_email@gmail.com'

# =============================================================================
# NOTIFICATION BACKENDS (ADR-039)
# =============================================================================

# Active notify backends, tried in order; defaults to email only so existing
# setups are unchanged. Accepts a list or a CSV string, e.g. ['email', 'telegram'].
NOTIFY_BACKENDS = ['email']

# Telegram backend -- only used when 'telegram' is in NOTIFY_BACKENDS.
TELEGRAM_BOT_TOKEN = ''   # from @BotFather
TELEGRAM_CHAT_ID = ''     # target chat/channel id

# =============================================================================
# DOWNLOADER BACKENDS (ADR-039)
# =============================================================================

# Active downloader backend — single-select (mutually exclusive).
# Defaults to 'qb'. Set to 'transmission' to route add-torrent calls to Transmission.
DOWNLOADER_BACKEND = 'qb'

# Transmission backend -- only used when DOWNLOADER_BACKEND = 'transmission'.
TRANSMISSION_HOST = '192.168.1.10'       # Transmission daemon host
TRANSMISSION_PORT = 9091                  # Transmission RPC port (default 9091)
TRANSMISSION_USERNAME = ''               # leave empty if no auth configured
TRANSMISSION_PASSWORD = ''
TRANSMISSION_DOWNLOAD_DIR = '/downloads' # default save directory

# =============================================================================
# MAGNET SOURCES / INDEXERS (ADR-054 WS3)
# =============================================================================

# Active external magnet indexers, queried in a fan-out (every active source).
# Default empty = feature OFF (no aggregation, capability flag false). Accepts a
# list or a CSV string, e.g. ['javbus', 'sukebei']. Aggregation runs server-side
# in the Python backend only; the Cloudflare Worker cannot reach external hosts.
MAGNET_SOURCES = []

# Per-source base URLs (override only if you use a mirror).
JAVBUS_BASE_URL = 'https://www.javbus.com'
SUKEBEI_BASE_URL = 'https://sukebei.nyaa.si'

# Whether indexer fetches go through the proxy pool (recommended for ban safety).
MAGNET_SOURCES_USE_PROXY = True

# Per-source wall-clock budget for external indexer fan-out. Slow sources return
# a timeout result without blocking faster sources.
MAGNET_SOURCE_TIMEOUT_SECONDS = 10.0

# =============================================================================
# PROXY CONFIGURATION
# =============================================================================

# PROXY MODE SELECTION
# Options:
#   'pool'   - Use proxy pool with automatic failover (recommended, default)
#   'single' - Use only the first proxy (main proxy) from PROXY_POOL
#   'None'   - Disable proxy entirely (direct connection only)
PROXY_MODE = 'pool'

# =============================================================================
# UNIFIED PROXY CONFIGURATION
# =============================================================================

# Proxy pool - List of proxies for use in both single and pool modes
# 
# IMPORTANT: 
#   - In 'single' mode: Only the FIRST proxy is used (main proxy)
#   - In 'pool' mode: All proxies are used with automatic failover
#
# Each proxy should be a dictionary with 'http', 'https', and optional 'name' keys
# Supported formats:
#   HTTP: 'http://proxy.example.com:8080'
#   HTTPS: 'https://proxy.example.com:8080'
#   SOCKS5: 'socks5://proxy.example.com:1080'
#   With auth: 'http://username:password@proxy.example.com:8080'
#
# IMPORTANT: If your password contains special characters, you need to URL-encode them:
#   Space     -> %20
#   !         -> %21
#   #         -> %23
#   $         -> %24
#   %         -> %25
#   &         -> %26
#   @         -> %40
#   :         -> %3A (only in password, not after @)
#   /         -> %2F
#   ?         -> %3F
#   =         -> %3D
#   +         -> %2B
#
# Example: password "My@Pass!" should be "My%40Pass%21"
# You can use Python to encode: from urllib.parse import quote; print(quote("My@Pass!", safe=''))

PROXY_POOL = [
    # Main proxy (used in both single and pool modes)
    {
        'name': 'Main-Proxy',
        'http': 'http://127.0.0.1:7890',
        'https': 'http://127.0.0.1:7890'
    },
    # Backup proxy 1 (only used in pool mode)
    {
        'name': 'Backup-Proxy-1',
        'http': 'http://127.0.0.1:7891',
        'https': 'http://127.0.0.1:7891'
    },
    # Backup proxy 2 (only used in pool mode)
    # {
    #     'name': 'Backup-Proxy-2',
    #     'http': 'http://127.0.0.1:7892',
    #     'https': 'http://127.0.0.1:7892'
    # },
    # Example with authentication (password with special chars encoded)
    # {
    #     'name': 'Auth-Proxy',
    #     'http': 'http://username:My%40Pass%21@proxy.example.com:8080',
    #     'https': 'http://username:My%40Pass%21@proxy.example.com:8080'
    # },
    # Example SOCKS5 proxy (requires: pip install requests[socks])
    # {
    #     'name': 'SOCKS5-Proxy',
    #     'http': 'socks5://127.0.0.1:1080',
    #     'https': 'socks5://127.0.0.1:1080'
    # },
]

# Proxy pool behavior settings (only applies when PROXY_MODE = 'pool')
# Ban records are session-scoped (in-memory only) and reset on each new run
PROXY_POOL_MAX_FAILURES = 3  # Max consecutive failures before banning proxy for this session

# =============================================================================
# LEGACY PROXY CONFIGURATION (DEPRECATED - for backward compatibility only)
# =============================================================================
# These settings are deprecated. Please use PROXY_POOL above instead.
# If set, these will override the first entry in PROXY_POOL for backward compatibility.
PROXY_HTTP = None  # Deprecated: Use PROXY_POOL instead
PROXY_HTTPS = None  # Deprecated: Use PROXY_POOL instead

# Proxy modules control which modules use proxy in the default auto mode.
# Manual CLI overrides:
#   --use-proxy  Force-enable proxy for every module in that command
#   --no-proxy   Force-disable proxy for every module in that command
# Available modules:
#   'spider'      - All JavDB requests (index pages, detail pages, login/session refresh)
#   'qbittorrent' - qBittorrent Web UI API requests
#   'pikpak'      - PikPak bridge qBittorrent API requests
# Add module names to the list to enable proxy for those modules
# Leave empty list [] to disable proxy for all modules
# Use ['all'] to enable proxy for all modules
PROXY_MODULES = ['spider']

# Cloudflare Worker URL + Bearer token for cross-runner proxy coordination
# (throttle, ban sync, login-state, etc.). Leave both empty to disable.
# GitHub Actions: set repo Variable PROXY_COORDINATOR_URL and Secret
# PROXY_COORDINATOR_TOKEN; config_generator writes them into config.py.
PROXY_COORDINATOR_URL = ''
PROXY_COORDINATOR_TOKEN = ''
# Name of the proxy to use for the login CLI (must match a PROXY_POOL entry so
# the published cookie binds to a specific worker on CI runners).  Leave empty
# to use the first pool proxy or the configured single PROXY_HTTP/HTTPS proxy.
LOGIN_PROXY_NAME = ''

# MovieClaim per-day mutex activation (P1-B / P2-E auto-toggle).
# Three-state semantics; case-insensitive, leading/trailing whitespace ignored:
#   'auto'  (default) - driven by RunnerRegistry's `movie_claim_recommended`
#                       signal: claim mutex is mounted only when the live
#                       runner cohort reaches MOVIE_CLAIM_MIN_RUNNERS (Worker
#                       var, default 2).  Single-runner deploys pay zero
#                       claim overhead, multi-runner deploys auto-coordinate.
#   'true' / '1' / 'yes' - force-on.  Mounts the claim client unconditionally
#                          and ignores the registry signal.  Use during the
#                          mixed old-Worker / new-client rollout window or
#                          when the operator explicitly wants the legacy
#                          P1-B always-on behaviour.
#   'false' / '0' / 'no' / '' - force-off.  Spider runs identically to
#                                "DO not configured" (per-process dedup only).
#                                Note: the *unset* default is 'auto'; the
#                                *empty string* is an explicit force-off.
# GH Variables → MOVIE_CLAIM_ENABLED feeds this (config_generator writes it
# into config.py).  Leaving it unset here keeps the new default.
MOVIE_CLAIM_ENABLED = 'auto'

# RUNNER_REGISTRY_ENABLED: when 'true', the spider POSTs /register at startup
# against the Cloudflare ``RunnerRegistry`` Durable Object, sends 60s heart-
# beats, and unregisters on exit.  This makes the run visible to peers so
# MovieClaim's ``auto`` mount/unmount, proxy-pool drift detection, and
# cohort summaries can take it into account.  Leave 'false' (the default)
# to preserve historic single-runner behaviour.  GH Variable
# RUNNER_REGISTRY_ENABLED feeds this via config_generator.
RUNNER_REGISTRY_ENABLED = 'false'

# ADR-033 media closed-loop: active acquisition outcomes (queued/downloading)
# that have not been seen in qB for this many days are marked 'stalled'
# (and 'failed' after 2x this window). Tune to your slowest expected download.
# Must be a positive integer.
RECONCILE_STALLED_DAYS = 7

# ADR-033 Phase 2 (ownership truth): informational only — the reconcile pass reads the
# source list from javdb.ops.reconcile.models.OWNERSHIP_SOURCES (a hardcoded constant),
# NOT from this config entry. Editing this value here has no runtime effect today.
# Shown here for documentation purposes: gdrive (RcloneInventory projection),
# qb (AcquisitionOutcome bridge), and pikpak (PikpakHistory success rows) are active
# collectors. 'nas' is a forward-compat stub that always collects nothing.
OWNERSHIP_SOURCES = ['gdrive', 'qb', 'pikpak', 'nas']

# Forward-compat placeholder for a future NAS ownership collector. The current NAS
# collector is a stub that always logs "nas ownership not collected" and returns [].
# Setting this value has no runtime effect today — the stub does not read it.
RCLONE_NAS_REMOTE = ''

# ADR-033 media closed-loop (Phase 3): media servers polled for watch signal.
# A list of dicts, one per server instance. Multiple servers of the same type
# are first-class (e.g. two Plex). Tokens are inline (config.py is encrypted at
# rest as config.py.enc) and are masked in all logs.
#
#   type      : 'emby' | 'plex'
#   instance  : a unique connection id; flows into ConsumptionSignal.instance
#   base_url  : http(s)://host:port (no trailing slash needed)
#   token     : Emby API key (X-Emby-Token) / Plex token (X-Plex-Token)
#   libraries : OPTIONAL list of human-readable library NAMES to scan;
#               omit to scan ALL libraries on that server.
MEDIA_SERVERS = [
    # {
    #     'type': 'emby',
    #     'instance': 'emby-nas',
    #     'base_url': 'http://192.168.1.50:8096',
    #     'token': 'your_emby_api_key',
    #     'libraries': ['JAV'],
    # },
    # {
    #     'type': 'plex',
    #     'instance': 'plex-home',
    #     'base_url': 'http://192.168.1.51:32400',
    #     'token': 'your_plex_token',
    #     # 'libraries' omitted -> scan all libraries
    # },
]

# Example configurations:
# PROXY_MODULES = ['spider']  # Default: only spider (including login), not qBittorrent/PikPak
# PROXY_MODULES = ['all']  # Enable proxy for all modules
# PROXY_MODULES = ['spider', 'qbittorrent']  # Spider and qBittorrent
# PROXY_MODULES = ['qbittorrent', 'pikpak']  # Only qBittorrent and PikPak, not spider
# PROXY_MODULES = []  # Disable proxy for all modules by default

# =============================================================================
# CLOUDFLARE BYPASS CONFIGURATION
# =============================================================================

# CloudflareBypassForScraping service configuration
# Deploy the service from: https://github.com/sarperavci/CloudflareBypassForScraping
# Run with: docker compose up -d (default port: 8000)
#
# The service URL is dynamically generated based on proxy configuration:
#   - Without proxy: http://localhost:{CF_BYPASS_SERVICE_PORT}
#   - With proxy pool: http://{PROXY_IP}:{CF_BYPASS_SERVICE_PORT}
#     (uses the IP from current proxy in the pool)
#
# The spider only ever speaks CloudflareBypassForScraping's URL-parameter API:
#   GET {service_url}/html?url={urlencoded_target}
# Cache refreshes reuse that same endpoint with the header `x-bypass-cache: true`.
# The upstream project's request-mirroring mode (gated on an `x-hostname` header)
# is NOT used, so no `x-hostname` is ever sent.
#
# IMPORTANT: Deploy the CF bypass service on each proxy server using the same port
CF_BYPASS_SERVICE_PORT = 8000

# Master switch for the CF bypass tier. When False, every bypass attempt is
# skipped and the spider only ever fetches directly -- Cloudflare-challenged
# pages then simply fail. Leave True unless you are deliberately isolating a
# problem to the direct path.
CF_BYPASS_ENABLED = True

# Reach each proxy's CF bypass service by tunnelling THROUGH that proxy to
# 127.0.0.1:{port}, instead of dialling {proxy_ip}:{port} directly. This lets
# you bind every bypass service to loopback only (off the public internet)
# without a firewall or VPN.
#   - False (default): runner connects directly to {proxy_ip}:{port}
#                       -> bypass must be reachable at the proxy's IP
#   - True:            runner sends the request through the proxy to
#                       127.0.0.1:{port} -> bypass can bind to loopback only
# Requires the proxy software to allow forwarding to 127.0.0.1 (Clash/mihomo:
# OK by default; Squid: add `acl bypass dst 127.0.0.1` + allow to_localhost).
CF_BYPASS_VIA_PROXY = False

# Per-proxy port overrides for the bypass service, keyed by proxy IP. Only the
# listed proxies deviate; everything else keeps CF_BYPASS_SERVICE_PORT. Useful
# during a staged rollout where some hosts run a solver on a different port
# than the rest.
#   CF_BYPASS_PORT_MAP = {'10.0.0.5': 9001}
# makes that one proxy's bypass URL http://10.0.0.5:9001 (or, with
# CF_BYPASS_VIA_PROXY = True, http://127.0.0.1:9001 through that proxy).
# In GitHub Actions this comes from the CF_BYPASS_PORT_MAP_JSON variable, which
# no workflow currently sets.
CF_BYPASS_PORT_MAP = {}

# =============================================================================
# SPIDER CONFIGURATION
# =============================================================================

# Page range for spider. In daily mode PAGE_END is a floor, not a ceiling —
# see the dynamic page scan below.
PAGE_START = 1
PAGE_END = 10

# Dynamic page scan (ADR-057). Daily mode treats PAGE_START..PAGE_END as a
# FLOOR: those pages are always scanned, and the scan then keeps going while
# pages still carry today/yesterday new-torrent badges, so a day whose new
# torrents run past PAGE_END is no longer truncated.
#   - PAGE_SCAN_DYNAMIC:    False restores the plain fixed range
#   - PAGE_SCAN_MAX:        hard ceiling; reaching it logs a warning because
#                           the fresh block may have been cut short
#   - PAGE_SCAN_STOP_AFTER: how many consecutive pages with no fresh entries
#                           end the scan. A page that fails to fetch or
#                           validate is NOT counted as fresh-free — one proxy
#                           blip must not truncate the day — but it spends its
#                           own budget of the same size: this many consecutive
#                           unreadable pages also end the scan, with reason
#                           `unreadable`. So under a proxy outage the scan
#                           stops this many pages past where it started
#                           failing, not at PAGE_SCAN_MAX. Must be >= 1; a
#                           lower value is floored to 1, since both counters
#                           start at 0 and 0 would stop the scan on its first
#                           page past PAGE_END even if that page were full of
#                           new torrents.
# Inert for ad-hoc URLs, --all, --ignore-release-date and
# IGNORE_RELEASE_DATE_FILTER: those have no freshness signal to steer on.
PAGE_SCAN_DYNAMIC = True
PAGE_SCAN_MAX = 30
PAGE_SCAN_STOP_AFTER = 2

# Phase 2 config
PHASE2_MIN_RATE = 4.0
PHASE2_MIN_COMMENTS = 100

# Daily-only index video-code-family blacklist.
# Defaults to excluding western studio/date cards from daily ingestion while
# the parser still recognizes them and ad-hoc ingestion still uses them.
# Set to [] to opt out of the western default.
DAILY_INDEX_VIDEO_CODE_FAMILY_BLACKLIST = ['western_studio_date']

# Base URL for JavDB
BASE_URL = 'https://javdb.com'

# =============================================================================
# JAVDB LOGIN CONFIGURATION (for automatic session cookie refresh)
# =============================================================================

# JavDB login credentials (optional - for automatic cookie refresh)
# Fill in your credentials and run: python3 scripts/login.py
JAVDB_USERNAME = ''  # Your JavDB email or username
JAVDB_PASSWORD = ''  # Your JavDB password

# GPT API for AI-powered captcha solving (required for automatic login — no manual fallback)
# Sends the captcha image to a vision model for recognition.
# Compatible with OpenAI API or any OpenAI-compatible API (e.g., api.gpt.ge)
GPT_API_URL = 'https://api.gpt.ge/v1/chat/completions'  # API endpoint
GPT_API_KEY = ''  # Your API key (e.g., sk-xxx)

# Captcha-solving model tuning (all optional; benchmark-backed defaults below).
# A 720-attempt benchmark against JavDB's live captcha found qwen-vl-ocr to be
# the fastest/cheapest of the top accuracy tier (~25% single-shot) with clean
# output. Any OpenAI-compatible vision model works (e.g. gpt-4o, gpt-4o-mini).
CAPTCHA_MODEL = 'qwen-vl-ocr'
# max_tokens for the solve call. Reasoning models (gpt-5-*, gemini-*-thinking)
# burn 700-1700 hidden tokens before emitting an answer, so a low budget makes
# them return empty. 2000 is safe for every model; OCR models ignore the slack.
CAPTCHA_MAX_TOKENS = 2000
# Login retries. Single-shot captcha accuracy is inherently low, so login
# retries with a fresh captcha each time: p@n = 1-(1-p)^n. 8 lifts a 25%
# solver to ~90% login success.
LOGIN_MAX_RETRIES = 8

# AI operations diagnosis assistant (ADR-026)
# Phase 1 remains read-only. When disabled or not configured, the assistant
# still produces deterministic detector-based diagnoses.
OPS_DIAGNOSIS_AI_ENABLED = False
OPS_DIAGNOSIS_API_URL = ''
OPS_DIAGNOSIS_API_KEY = ''
OPS_DIAGNOSIS_MODEL = 'deterministic-fallback-v1'
OPS_DIAGNOSIS_MAX_LOG_SNIPPETS = 20

# ADR-035 site-contract drift sentinel.
SENTINEL_MIN_SAMPLE = 30      # skip drift evaluation when a run parsed fewer items
SENTINEL_BASELINE_WINDOW = 14 # soft-field baseline = median over this many committed runs
# ADR-035 Phase 2 — independent canary (apps.cli.ops.sentinel --canary).
# Override the pinned index page (defaults to the homepage):
SENTINEL_CANARY_INDEX_URL = 'https://javdb.com/'
# Golden anchors: known-stable detail pages with expected parsed values. Capture
# with `python -m apps.cli.ops.sentinel --capture-anchors --url <detail-url>`,
# then paste the values here. Empty = fill-rate-only canary (still useful).
SENTINEL_CANARY_ANCHORS = [
    # {'url': 'https://javdb.com/v/XXXXX', 'video_code': 'ABC-123',
    #  'title_contains': 'Some Stable Title', 'min_magnets': 3},
]

# JavDB session cookie (can be auto-updated by scripts/login.py)
# Manual method: Get from browser → Developer Tools → Application → Cookies → _jdb_session
# Automatic method: Set credentials above and run: python3 scripts/login.py
JAVDB_SESSION_COOKIE = ''

# -----------------------------------------------------------------------------
# Login retry / verification policy
# -----------------------------------------------------------------------------
# Per-proxy and global retry budget for the auto-login feature.
#   * LOGIN_ATTEMPTS_PER_PROXY_LIMIT caps how many login refreshes any single
#     proxy may perform per run (default 6).
#   * LOGIN_MAX_FAILURES_BEFORE_PROXY_SWITCH caps how many stale-session
#     failures trigger a proxy switch (default 3).
#   * The global budget is initially len(PROXY_POOL) * LOGIN_ATTEMPTS_PER_PROXY_LIMIT
#     and is automatically reduced when a proxy is banned (its remaining
#     unused attempts are removed from the global cap).
LOGIN_ATTEMPTS_PER_PROXY_LIMIT = 6
LOGIN_MAX_FAILURES_BEFORE_PROXY_SWITCH = 3

# After the auto-login refresh succeeds, the spider validates the freshly
# obtained cookie by fetching these "login-required" pages through the same
# worker.  Login is only treated as verified when every URL returns a
# non-login response.  Once verified, the original task is re-queued and a
# subsequent login wall on that page is treated as a page-level failure
# (no further login attempts are spent on it).
#
# Items may be absolute URLs or paths relative to BASE_URL.  Provide at
# least one detail-style and one index-style page that require an active
# session to display content.  Set to [] to disable verification (legacy
# behaviour: trust the login response).
LOGIN_VERIFICATION_URLS = [
    '/users/want_watch_videos',  # detail-style (user-specific list page)
    '/users',                    # index-style (user profile landing)
]

# Sleep time configuration (in seconds)
# MOVIE_SLEEP_MIN/MAX are auto-tuned by the adaptive sleep system (MovieSleepManager).
# Override only for CI/testing via env var VAR_MOVIE_SLEEP (e.g. "0,0").
# All cooldowns (CF, fallback, login retry) are derived adaptively from MovieSleepManager.

